set(OS "Unknown")
# L_ETCDIR (global config dir) can be given on the command line (-DL_ETCDIR=...), as with qmake's isEmpty(L_ETCDIR);
# otherwise it defaults to <prefix>/etc, or to the per-distro value set below.
set(_L_ETCDIR_DEFAULT "${CMAKE_INSTALL_PREFIX}/etc")
set (L_SHAREDIR "${CMAKE_INSTALL_PREFIX}/share")
if(CMAKE_SYSTEM_NAME MATCHES "FreeBSD")
	set(OS "FreeBSD")
elseif(CMAKE_SYSTEM_NAME MATCHES "DragonFly")
	set(OS "DragonFly")
elseif(CMAKE_SYSTEM_NAME MATCHES "OpenBSD")
	set(OS "OpenBSD")
elseif(CMAKE_SYSTEM_NAME MATCHES "NetBSD")
	set(OS "NetBSD")
elseif (CMAKE_SYSTEM_NAME MATCHES "Linux")
	# cmake_host_system_information(... QUERY DISTRIB_NAME) needs CMake 3.22 (the minimum is 3.16), so read
	# os-release directly on older versions
	set(LINUX_DISTRO "")
	if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.22)
		cmake_host_system_information(RESULT LINUX_DISTRO QUERY DISTRIB_NAME)
	else()
		foreach(_osrel /etc/os-release /usr/lib/os-release)
			if(EXISTS ${_osrel})
				file(STRINGS ${_osrel} _osname REGEX "^NAME=")
				string(REGEX REPLACE "^NAME=\"?([^\"]*)\"?$" "\\1" LINUX_DISTRO "${_osname}")
				break()
			endif()
		endforeach()
	endif()
	if (LINUX_DISTRO MATCHES "Fedora")
		set(OS "Fedora")
		set (_L_ETCDIR_DEFAULT "/etc")
	elseif (LINUX_DISTRO MATCHES "Gentoo")
		set(OS "Gentoo")
		get_filename_component(_L_ETCDIR_DEFAULT "${CMAKE_INSTALL_PREFIX}/../etc" ABSOLUTE)
	elseif (LINUX_DISTRO MATCHES "Slackware")
		set(OS "Slackware")
	elseif (LINUX_DISTRO MATCHES "Void")
		set(OS "VoidLinux")
		get_filename_component(_L_ETCDIR_DEFAULT "${CMAKE_INSTALL_PREFIX}/../etc" ABSOLUTE)
	else()
		set(OS "Linux")
	endif()
endif()
# (these branches used to set ETCDIR, which nothing reads, so L_ETCDIR stayed <prefix>/etc everywhere)
set(L_ETCDIR "${_L_ETCDIR_DEFAULT}" CACHE PATH "Directory for Lumina's global config files")
